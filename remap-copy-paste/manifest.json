{
  "manifest_version": 3,
  "name": "Remap Copy Paste",
  "version": "1.0",
  "permissions": ["clipboardRead", "clipboardWrite", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "remap-copy": {
      "suggested_key": { "default": "Ctrl+Shift+C" },
      "description": "Remap Copy"
    },
    "remap-paste": {
      "suggested_key": { "default": "Ctrl+Shift+V" },
      "description": "Remap Paste"
    }
  }
}
